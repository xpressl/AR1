# ==============================================================================
# AR Control Hub - Production Environment Template
# ==============================================================================
# Copy this file to .env.production and fill in your production values
# NEVER commit the actual .env.production file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=production
VERSION=1.0.0

# Docker registry for production images
DOCKER_REGISTRY=your-registry.example.com/

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
# For production, use managed database service (RDS, Cloud SQL, etc.)
POSTGRES_HOST=your-postgres-host.example.com
POSTGRES_PORT=5432
POSTGRES_DB=ar_control_hub_prod
POSTGRES_USER=ar_prod_user
# IMPORTANT: Use a strong, unique password!
# Store securely in secrets manager, not here
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD>

# ------------------------------------------------------------------------------
# Redis Cache & Message Queue
# ------------------------------------------------------------------------------
# For production, use managed Redis service (ElastiCache, Redis Cloud, etc.)
REDIS_HOST=your-redis-host.example.com
REDIS_PORT=6379
# IMPORTANT: Use a strong password for Redis
REDIS_PASSWORD=<GENERATE_SECURE_PASSWORD>
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO

# JWT Authentication
# IMPORTANT: Generate a secure secret!
# Run: openssl rand -hex 64
JWT_SECRET=<GENERATE_SECURE_SECRET>
JWT_EXPIRY_HOURS=8

# CORS - Your production frontend domain
CORS_ORIGINS=https://app.your-domain.com

# Trusted hosts
TRUSTED_HOSTS=app.your-domain.com,api.your-domain.com

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------
# Use a production email service (SendGrid, SES, Mailgun, etc.)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=AR Control Hub
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# Data Import Configuration
# ------------------------------------------------------------------------------
IMPORT_DATA_PATH=/app/data/imports
# Run imports at 2 AM daily
IMPORT_SCHEDULE=0 2 * * *

# ------------------------------------------------------------------------------
# Worker Configuration (replicas for high availability)
# ------------------------------------------------------------------------------
BACKEND_REPLICAS=3
FRONTEND_REPLICAS=2
EMAIL_WORKER_REPLICAS=2

# ------------------------------------------------------------------------------
# Monitoring & Logging
# ------------------------------------------------------------------------------
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Prometheus metrics
METRICS_PORT=9090

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
ENABLE_DEBUG_TOOLBAR=false
ENABLE_API_DOCS=false
ENABLE_METRICS=true

# Rate limiting (stricter in production)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# File Upload
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls,.pdf

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# ------------------------------------------------------------------------------
# SSL/TLS Configuration
# ------------------------------------------------------------------------------
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# ------------------------------------------------------------------------------
# Backup Configuration
# ------------------------------------------------------------------------------
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_RETENTION_DAYS=30
