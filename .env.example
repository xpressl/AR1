# ==============================================================================
# AR Control Hub - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
# Values: development, staging, production
ENVIRONMENT=development

# Docker image version tag
VERSION=latest

# Docker registry (optional, for production deployments)
DOCKER_REGISTRY=

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ar_control_hub
POSTGRES_USER=ar_user
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=

# Full database connection URL (alternative to individual settings)
# DATABASE_URL=postgresql://ar_user:password@postgres:5432/ar_control_hub

# ------------------------------------------------------------------------------
# Redis Cache & Message Queue
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# For production: set a strong password
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO

# JWT Authentication
# IMPORTANT: Generate a secure secret for production!
# Example: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# CORS - Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Trusted hosts for production
TRUSTED_HOSTS=localhost

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NODE_ENV=development

# API URL for frontend (must be accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=AR Control Hub
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# Data Import Configuration
# ------------------------------------------------------------------------------
IMPORT_DATA_PATH=/app/data/imports
# Cron schedule for automated imports (default: 2 AM daily)
IMPORT_SCHEDULE=0 2 * * *

# ------------------------------------------------------------------------------
# Epicor Eagle CSV Import Configuration
# ------------------------------------------------------------------------------
# Path to directory containing CSV exports from Epicor Eagle
EPICOR_CSV_IMPORT_PATH=/data/epicor/exports

# CSV file encoding (utf-8, utf-8-sig, latin-1, cp1252)
EPICOR_CSV_ENCODING=utf-8

# CSV field delimiter
EPICOR_CSV_DELIMITER=,

# Date format in CSV files (Python strftime format)
EPICOR_CSV_DATE_FORMAT=%Y-%m-%d

# DateTime format in CSV files
EPICOR_CSV_DATETIME_FORMAT=%Y-%m-%d %H:%M:%S

# ------------------------------------------------------------------------------
# Epicor Eagle Database Connection (Optional - Direct Read-Only Access)
# ------------------------------------------------------------------------------
# Leave empty to use CSV import only

# Database server hostname or IP
EPICOR_DB_HOST=

# Database server port (default: 1433 for SQL Server)
EPICOR_DB_PORT=1433

# Database name
EPICOR_DB_NAME=

# Database username (read-only account recommended)
EPICOR_DB_USER=

# Database password
EPICOR_DB_PASSWORD=

# ODBC Driver name (must be installed on system)
EPICOR_DB_DRIVER=ODBC Driver 17 for SQL Server

# ------------------------------------------------------------------------------
# Epicor Connection Settings
# ------------------------------------------------------------------------------
# Connection timeout in seconds
EPICOR_CONNECTION_TIMEOUT=30

# Maximum retry attempts for failed operations
EPICOR_MAX_RETRIES=3

# Base delay between retries in seconds (exponential backoff)
EPICOR_RETRY_DELAY=5

# ------------------------------------------------------------------------------
# Epicor File Watcher Settings
# ------------------------------------------------------------------------------
# Enable automatic file watching for new imports
EPICOR_WATCH_ENABLED=false

# Polling interval for file watcher in seconds (10-3600)
EPICOR_WATCH_POLL_INTERVAL=60

# Debounce delay to wait for file writes to complete (seconds)
EPICOR_WATCH_DEBOUNCE_DELAY=5.0

# ------------------------------------------------------------------------------
# Epicor Health Check Settings
# ------------------------------------------------------------------------------
# Interval between automatic health checks in seconds
EPICOR_HEALTH_CHECK_INTERVAL=300

# Timeout for health check operations in seconds
EPICOR_HEALTH_CHECK_TIMEOUT=10

# ------------------------------------------------------------------------------
# Worker Configuration
# ------------------------------------------------------------------------------
# Number of replicas for production deployment
BACKEND_REPLICAS=2
FRONTEND_REPLICAS=2
EMAIL_WORKER_REPLICAS=2

# ------------------------------------------------------------------------------
# Monitoring & Logging
# ------------------------------------------------------------------------------
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Prometheus metrics port (optional)
METRICS_PORT=9090

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
ENABLE_DEBUG_TOOLBAR=false
ENABLE_API_DOCS=true
ENABLE_METRICS=false

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# File Upload
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls,.pdf

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
