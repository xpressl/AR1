# ============================================================
# AR Control Hub - Production Environment Configuration
# ============================================================
#
# IMPORTANT: This is a template file. Copy it to .env.production and
# fill in all values with your production settings.
#
# DO NOT commit .env.production to version control!
# Add .env.production to .gitignore
#
# Security Best Practices:
#   - Use strong, unique passwords (16+ characters)
#   - Generate JWT secret with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   - Store backup of this file in secure password manager (1Password, KeePass, etc.)
#   - Restrict file permissions: chmod 600 .env.production
#   - Never share credentials via email or Slack
#

# ============================================================
# Database Configuration
# ============================================================

# PostgreSQL database URL
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://ar_admin:CHANGE_ME_STRONG_PASSWORD@localhost:5432/ar_control_hub_prod

# Database pool settings (adjust based on server resources)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================================
# API Configuration
# ============================================================

# Environment
ENVIRONMENT=production

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# API URL (used by frontend)
API_URL=https://ar.company.com

# ============================================================
# Security & Authentication
# ============================================================

# JWT Secret Key - MUST BE STRONG AND UNIQUE
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_COMMAND_ABOVE_64_PLUS_CHARACTERS_MINIMUM

# JWT Algorithm (keep as HS256 unless you have specific requirements)
JWT_ALGORITHM=HS256

# Access token expiration (in minutes)
# Recommended: 60 minutes for production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token expiration (in days)
# Recommended: 7 days for production
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================

# Allowed origins (comma-separated, NO SPACES)
# Add all domains that will access your API
CORS_ORIGINS=https://ar.company.com,https://www.company.com

# CORS credentials
CORS_ALLOW_CREDENTIALS=true

# ============================================================
# Frontend Configuration
# ============================================================

# Next.js environment
NODE_ENV=production

# Frontend URL (for emails, redirects, etc.)
FRONTEND_URL=https://ar.company.com

# Next.js API URL (points to backend)
NEXT_PUBLIC_API_URL=https://ar.company.com/api

# ============================================================
# Email / SMTP Configuration
# ============================================================

# SMTP Server
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USE_TLS=true

# SMTP Authentication
SMTP_USERNAME=ar-notifications@company.com
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD_HERE

# Email sender details
SMTP_FROM_EMAIL=ar-notifications@company.com
SMTP_FROM_NAME=AR Control Hub

# Admin email (for alerts, error notifications)
ADMIN_EMAIL=admin@company.com

# ============================================================
# Epicor ERP Integration
# ============================================================

# Epicor API endpoint
EPICOR_API_URL=https://epicor.company.com/api/v1

# Epicor API credentials
EPICOR_API_KEY=CHANGE_ME_EPICOR_API_KEY_HERE
EPICOR_API_USERNAME=epicor_integration_user
EPICOR_API_PASSWORD=CHANGE_ME_EPICOR_PASSWORD_HERE

# Epicor company ID
EPICOR_COMPANY_ID=YOUR_COMPANY_ID

# Import schedule (cron format: minute hour day month weekday)
# Default: Daily at 1:00 AM
EPICOR_IMPORT_SCHEDULE=0 1 * * *

# ============================================================
# Feature Flags
# ============================================================

# Enable/disable features (true/false)
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_DAILY_DIGEST=true
ENABLE_EPICOR_IMPORT=true
ENABLE_PROMISE_TRACKING=true
ENABLE_AUTO_ALERTS=true

# ============================================================
# Logging
# ============================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Recommended: INFO for production
LOG_LEVEL=INFO

# Log file location
LOG_FILE=/var/log/ar-control-hub/app.log

# Log format (json or text)
LOG_FORMAT=json

# Log rotation (handled by logrotate in production)
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ============================================================
# Monitoring & Performance
# ============================================================

# Enable performance monitoring
ENABLE_PROFILING=false

# Slow query threshold (in milliseconds)
# Queries slower than this will be logged
SLOW_QUERY_THRESHOLD=1000

# Request timeout (in seconds)
REQUEST_TIMEOUT=30

# ============================================================
# Cache Configuration
# ============================================================

# Redis (optional - for caching and session storage)
# If not using Redis, leave commented out
# REDIS_URL=redis://localhost:6379/0

# Cache TTL (in seconds)
CACHE_TTL=300  # 5 minutes

# ============================================================
# Business Logic Configuration
# ============================================================

# Days Sales Outstanding (DSO) target
DSO_TARGET=35

# Cash flow forecast weeks
CASH_FORECAST_WEEKS=8

# Aging buckets (comma-separated, NO SPACES)
AGING_BUCKETS=30,60,90

# Risk score weights (must sum to 1.0)
RISK_WEIGHT_AGING=0.4
RISK_WEIGHT_PAYMENT_HISTORY=0.3
RISK_WEIGHT_BROKEN_PROMISES=0.2
RISK_WEIGHT_CREDIT_UTILIZATION=0.1

# ============================================================
# Alerts & Notifications
# ============================================================

# Alert thresholds
ALERT_CRITICAL_DAYS_OVERDUE=90
ALERT_WARNING_DAYS_OVERDUE=60

# Daily digest schedule (cron format)
# Default: 8:00 AM every weekday
DAILY_DIGEST_SCHEDULE=0 8 * * 1-5

# Digest recipient emails (comma-separated, NO SPACES)
DAILY_DIGEST_RECIPIENTS=sarah.martinez@company.com,michael.chen@company.com

# ============================================================
# Backup Configuration
# ============================================================

# Backup directory
BACKUP_DIR=/var/backups/ar-control-hub

# Backup retention (in days)
BACKUP_RETENTION_DAYS=30

# Backup encryption (optional)
# BACKUP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_STRONG_KEY

# ============================================================
# Rate Limiting (optional)
# ============================================================

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# External Services (optional)
# ============================================================

# Sentry (error tracking)
# SENTRY_DSN=https://your-sentry-dsn-here

# Google Analytics
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# ============================================================
# Development/Debug Settings
# ============================================================

# NEVER set these to true in production!
DEBUG=false
ENABLE_DEBUG_TOOLBAR=false
ENABLE_SWAGGER_UI=false  # Set to true if you want API docs in production

# ============================================================
# Custom Company Configuration
# ============================================================

# Company name (used in emails, reports)
COMPANY_NAME=Your Company Name

# Company timezone
TIMEZONE=America/New_York

# Currency symbol
CURRENCY_SYMBOL=$

# Date format (for reports)
DATE_FORMAT=%Y-%m-%d

# ============================================================
# Notes
# ============================================================
#
# After editing this file:
#   1. Rename to .env.production: mv .env.production.template .env.production
#   2. Set restrictive permissions: chmod 600 .env.production
#   3. Verify all CHANGE_ME values are updated
#   4. Test configuration: python -c "from dotenv import load_dotenv; load_dotenv('.env.production'); import os; print('OK' if os.getenv('JWT_SECRET_KEY') else 'ERROR: JWT_SECRET_KEY not set')"
#   5. Never commit .env.production to git!
#
# For generating secure secrets:
#   - JWT Secret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   - Random Password: python3 -c "import secrets; import string; print(''.join(secrets.choice(string.ascii_letters + string.digits + string.punctuation) for i in range(32)))"
#
